#!/bin/bash
# info: change node application port
# options: USER APP PORT
#
# example: v-change-node-app-port admin frontend 30010
#
# This function moves a Node.js application to a different loopback port. The
# application must be restarted for the change to take effect.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

user=$1
app=$2
app_port=$3

# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/node.sh
source $HESTIA/func/node.sh
# shellcheck source=/usr/local/hestia/func/app.sh
source $HESTIA/func/app.sh
source_conf "$HESTIA/conf/hestia.conf"

cleanup() {
	app_port_lock_release
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER APP PORT'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_app_name_format_valid "$app"
is_app_port_format_valid "$app_port"
check_hestia_demo_mode

if ! app_exists "$user" "$app"; then
	check_result "$E_NOTEXIST" "application $app doesn't exist"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Same lock as allocation: checking a port is free and claiming it must not be
# interleaved with another application doing the same.
app_port_lock_acquire
trap cleanup EXIT

current=$(get_object_value 'app' 'NAME' "$app" '$PORT')
if [ "$current" != "$app_port" ]; then
	if ! is_app_port_available "$app_port"; then
		check_result "$E_EXISTS" "port $app_port is already in use"
	fi
	update_object_value 'app' 'NAME' "$app" '$PORT' "$app_port"
fi

app_port_lock_release

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/v-log-action "$user" "Info" "Node" "Changed port of Node.js application $app to $app_port."
log_event "$OK" "$ARGUMENTS"

exit
