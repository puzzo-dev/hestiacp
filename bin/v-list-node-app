#!/bin/bash
# info: list node application parameters
# options: USER APP [FORMAT]
#
# example: v-list-node-app admin ivarseltd json
#
# This function to obtain the parameters of a single Node.js application.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
app=$2
format=${3-shell}

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/node.sh
source $HESTIA/func/node.sh
# shellcheck source=/usr/local/hestia/func/app.sh
source $HESTIA/func/app.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON list function
json_list() {
	echo '{'
	echo '    "'$NAME'": {
        "DOMAIN": "'$DOMAIN'",
        "RUNTIME": "'$RUNTIME'",
        "RUNTIME_VERSION": "'$RUNTIME_VERSION'",
        "APP_ROOT": "'$APP_ROOT'",
        "PORT": "'$PORT'",
        "PACKAGE_MANAGER": "'$PACKAGE_MANAGER'",
        "BUILD_COMMAND": "'$BUILD_COMMAND'",
        "START_COMMAND": "'$START_COMMAND'",
        "SERVICE_NAME": "'$SERVICE_NAME'",
        "STATUS": "'$STATUS'",
        "AUTOSTART": "'$AUTOSTART'",
        "SUSPENDED": "'$SUSPENDED'",
        "TIME": "'$TIME'",
        "DATE": "'$DATE'"
    }'
	echo '}'
}

# SHELL list function
shell_list() {
	echo "NAME:            $NAME"
	echo "DOMAIN:          $DOMAIN"
	echo "RUNTIME:         $RUNTIME $RUNTIME_VERSION"
	echo "APP ROOT:        $APP_ROOT"
	echo "PORT:            $PORT"
	echo "PACKAGE MANAGER: $PACKAGE_MANAGER"
	echo "BUILD COMMAND:   $BUILD_COMMAND"
	echo "START COMMAND:   $START_COMMAND"
	echo "SERVICE:         $SERVICE_NAME"
	echo "STATUS:          $STATUS"
	echo "AUTOSTART:       $AUTOSTART"
	echo "SUSPENDED:       $SUSPENDED"
	echo "DATE:            $DATE $TIME"
}

# PLAIN list function
plain_list() {
	echo -e "$NAME\t$DOMAIN\t$RUNTIME\t$RUNTIME_VERSION\t$APP_ROOT\t$PORT\t$PACKAGE_MANAGER\t$BUILD_COMMAND\t$START_COMMAND\t$SERVICE_NAME\t$STATUS\t$AUTOSTART\t$SUSPENDED\t$TIME\t$DATE"
}

# CSV list function
csv_list() {
	echo "NAME,DOMAIN,RUNTIME,RUNTIME_VERSION,APP_ROOT,PORT,PACKAGE_MANAGER,SERVICE_NAME,STATUS,AUTOSTART,SUSPENDED,TIME,DATE"
	echo "$NAME,$DOMAIN,$RUNTIME,$RUNTIME_VERSION,$APP_ROOT,$PORT,$PACKAGE_MANAGER,$SERVICE_NAME,$STATUS,$AUTOSTART,$SUSPENDED,$TIME,$DATE"
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER APP [FORMAT]'
is_format_valid 'user' 'format'
is_object_valid 'user' 'USER' "$user"
is_app_name_format_valid "$app"

if ! app_exists "$user" "$app"; then
	check_result "$E_NOTEXIST" "application $app doesn't exist"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

object=$(grep -m 1 "NAME='$app'" "$(app_conf "$user")")
parse_object_kv_list "$object"
STATUS=$(app_status "$SERVICE_NAME")
AUTOSTART=$(app_autostart "$SERVICE_NAME")

# Listing data
case $format in
	json) json_list ;;
	plain) plain_list ;;
	csv) csv_list ;;
	shell) shell_list ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit
