#!/bin/bash
# info: change the node runtime an application uses
# options: USER APP VERSION
#
# example: v-change-node-app-runtime admin frontend 24
#
# This function pins a Node.js application to a different major version of the
# runtime. The application must be rebuilt and restarted afterwards: native
# modules compiled against the old major will not load.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

user=$1
app=$2
runtime_version=$3

# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/node.sh
source $HESTIA/func/node.sh
# shellcheck source=/usr/local/hestia/func/app.sh
source $HESTIA/func/app.sh
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER APP VERSION'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
is_app_name_format_valid "$app"
is_node_major_format_valid "$runtime_version"
check_hestia_demo_mode

if ! app_exists "$user" "$app"; then
	check_result "$E_NOTEXIST" "application $app doesn't exist"
fi
if ! node_runtime_exists "$runtime_version"; then
	check_result "$E_NOTEXIST" "Node.js $runtime_version is not installed"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

update_object_value 'app' 'NAME' "$app" '$RUNTIME_VERSION' "$runtime_version"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/v-log-action "$user" "Info" "Node" "Changed runtime of Node.js application $app to Node.js $runtime_version."
log_event "$OK" "$ARGUMENTS"

exit
